    <string name="email_explanation">Provide your email to link your transactions and container history with a single account.</string>
    
    <!-- Purchase Steps -->
    <string name="step1_title">Step 1 - Tap and Open</string>
    <string name="step1_desc">You\'ll hear a beep and the door unlocks. You have 15 seconds to open and start shopping.</string>
    <string name="step2_title">Step 2 - Select</string>
    <string name="step2_desc">Pick products. Each item is automatically added to your cart with name and price. Changed your mind? Put it back.</string>
    <string name="step3_title">Step 3 - Close</string>
    <string name="step3_desc">Close the door to finish. The system totals your products and charges your card. Confirmation shown in the app. Enjoy!</string>
    
    <!-- Return Containers Section -->
    <string name="return_containers">Return Containers</string>
    <string name="return_containers_desc">Return empty jars and get your deposit back.</string>
    
    <!-- Return Instructions Screen -->
    <string name="return_tap_prompt">Tap your card to start\nreturning containers.</string>
    <string name="return_step1_title">Step 1 - Tap and Open</string>
    <string name="return_step1_desc">Tap your card and you\'ll hear a beep - the door will unlock. Pull the handle and open the door wide for easy access!</string>
    <string name="return_step2_title">Step 2 - Return One by One</string>
    <string name="return_step2_desc">Place containers one at a time. The machine beeps for each correctly recognized package and it appears in the app - you\'ll see its name, size, and deposit amount. Unrecognized containers can also be accepted, but no deposit refund for those.</string>
    <string name="return_step3_title">Step 3 - Close and Done</string>
    <string name="return_step3_desc">When everything is in place, simply close the door. The system will automatically end your return session and send the deposit to your card. Thank you for giving packaging a second life!</string>
    
